# Server Environment
NODE_ENV=development
PORT=4000

# Database
MONGODB_URI=mongodb://localhost:27017/corvo

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h

# Initial seed accounts (required by pnpm seed)
INITIAL_ADMIN_EMAIL=admin@your-company.example
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password
INITIAL_BUYER_EMAIL=buyer@your-company.example
INITIAL_BUYER_PASSWORD=replace-with-a-strong-password

# AI Provider Configuration ('gemini', 'openai', or 'fallback')
AI_PROVIDER=fallback

# Frontend Configuration
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
