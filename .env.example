# ==============================================================================
# CORVO PROCUREMENT INTELLIGENCE — ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND (Render) REQUIRED ENVIRONMENT VARIABLES
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=10000

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/corvo_procurement?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/corvo_procurement?retryWrites=true&w=majority

# JWT Authentication (Min 32 characters high-entropy string)
JWT_SECRET=replace-with-a-cryptographically-secure-secret-min-32-chars
JWT_EXPIRES_IN=8h

# CORS Allowed Origins (Comma-separated list of allowed frontend domains)
# Example: https://corvo-procurement-intelligence.vercel.app,http://localhost:3000
CORS_ORIGIN=https://<your-vercel-app>.vercel.app

# Initial Administrator and Buyer Provisioning Credentials
INITIAL_ADMIN_EMAIL=admin@corvo.internal
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-admin-password
INITIAL_BUYER_EMAIL=buyer@corvo.internal
INITIAL_BUYER_PASSWORD=replace-with-a-strong-buyer-password

# ------------------------------------------------------------------------------
# 2. FRONTEND (Vercel) REQUIRED ENVIRONMENT VARIABLES
# ------------------------------------------------------------------------------
# URL of the deployed Render backend API
# Example: https://corvo-backend.onrender.com or https://corvo-backend.onrender.com/api
NEXT_PUBLIC_API_URL=https://<your-render-service>.onrender.com/api

# ------------------------------------------------------------------------------
# 3. OPTIONAL AI PROVIDER INTEGRATION (intake and amendment assistance)
# ------------------------------------------------------------------------------
AI_PROVIDER=fallback
GEMINI_API_KEY=your_optional_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro
OPENAI_API_KEY=your_optional_openai_api_key_here
OPENAI_MODEL=gpt-4o
